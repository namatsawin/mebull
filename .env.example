# =============================================================================
# Autonomous AI Portfolio Manager — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are read from env ONLY — never placed in prompts, DB, or logs (spec §62-63).
# =============================================================================

# --- Portfolio identity (spec §5) -------------------------------------------
APM_PORTFOLIO_ID=main-portfolio
APM_OWNER=namatsawin

# --- SAFETY: master kill switch (spec §36) ----------------------------------
# When false, NO real orders are ever placed. Analysis/research/journaling continue.
# This is the env-level half of the kill switch; a DB-backed flag is the other half.
APM_TRADING_ENABLED=false

# Execution mode: MOCK | SANDBOX | REAL  (spec §67 phased rollout; start non-REAL)
APM_EXECUTION_MODE=MOCK

# How often the AI runs a full decision cycle, in SECONDS. It decides freely each time
# (BUY/SELL/HOLD/WAIT/...). Lower = more reactive but more token cost. 300 = every 5 min.
APM_DECISION_INTERVAL_SECONDS=300

# Only run decision cycles while the US market is open (weekdays 09:30-16:00 ET, DST-aware,
# skips holidays). Saves ~65% of token cost vs running 24/7. Set false for local testing.
APM_MARKET_HOURS_ONLY=true

# Let the AI trade OPTIONS: includes an affordable option-chain slice per watchlist symbol
# in its context. Requires the Webull OPRA option-data subscription (else it 403s each cycle).
APM_OPTIONS_ENABLED=false

# --- Trading style / horizon -------------------------------------------------
# The trader's mandate, surfaced to the AI each cycle. "daytrade"/"scalp" bias toward active
# intraday trading; "swing" allows multi-day holds.
APM_TRADING_STYLE=daytrade
# Intraday-only: never hold overnight. The loop force-flattens all open positions once the
# session is within APM_FLATTEN_BEFORE_CLOSE_MINUTES of the close (deterministic, safe).
APM_INTRADAY_ONLY=true
APM_FLATTEN_BEFORE_CLOSE_MINUTES=15
# Soft guidance to the model: risk at most this % of buying power on a single trade.
APM_MAX_RISK_PER_TRADE_PCT=2.0

# --- Strategy mode (see docs/STRATEGY_MODES.md) ------------------------------
# "ai"   : Claude decides every cycle (~1 API call/cycle).
# "quant": deterministic rules engine decides every cycle (no AI in the hot path) + an AI
#          supervisor sets policy a few times/day. Cheap + reproducible ("B" architecture).
APM_STRATEGY_MODE=ai
# How often the AI supervisor refreshes its policy, in minutes (quant mode only).
APM_SUPERVISOR_INTERVAL_MINUTES=120

# --- Options (Model B, quant mode) -------------------------------------------
APM_OPTION_MAX_CONTRACTS=1               # contracts per trade (small account: 1)
APM_OPTION_MAX_PREMIUM_PCT_NAV=40.0      # cap one premium at this % of NAV (premium = max loss)
APM_OPTION_DELTA_MIN=0.50                # entry |delta| band (ATM, per Model B: 0.50-0.60)
APM_OPTION_DELTA_MAX=0.60
APM_OPTION_MAX_SPREAD_PCT=5.0            # reject if bid/ask spread exceeds this % of mid
APM_OPTION_VOLUME_Z_MIN=2.0             # Model B order-flow trigger: require 5m volume z >= this
APM_OPTION_TAKE_PROFIT_PCT=30.0          # sell-to-close at +this % premium
APM_OPTION_STOP_LOSS_PCT=20.0            # sell-to-close at -this % premium

# --- Historical data (free) --------------------------------------------------
# Webull's bars endpoint 404s for this entitlement, so HV20 / 5m volume_z / VIX are seeded
# from Yahoo (yfinance) into price_bar at startup (idempotent, graceful). Data-only, never
# execution. No config needed; watchlist symbols + ^VIX are fetched automatically.

# --- Database ----------------------------------------------------------------
# Inside docker-compose the host is `db`. For local runs use `localhost`.
APM_DATABASE_URL=postgresql+asyncpg://apm:apm@db:5432/apm
POSTGRES_USER=apm
POSTGRES_PASSWORD=apm
POSTGRES_DB=apm

# --- Anthropic (Claude) — sanctioned pay-per-token API key -------------------
# Do NOT use a Claude.ai subscription/OAuth for this always-on service (ban risk).
ANTHROPIC_API_KEY=
APM_CLAUDE_MODEL=claude-opus-4-8
APM_CLAUDE_PROVIDER=mock   # mock | anthropic

# --- Webull OpenAPI (wired in at M1) ----------------------------------------
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
# Region/host per your Webull developer account (e.g. us / hk / jp / th) — lowercase
WEBULL_REGION=us
# Traded-market category = the market of your SYMBOLS, not the account region.
# A Webull TH account trading SPY/QQQ still uses US_STOCK. (US_STOCK | US_ETF | HK_STOCK ...)
WEBULL_MARKET_CATEGORY=US_STOCK

# --- Observability -----------------------------------------------------------
APM_LOG_LEVEL=INFO
APM_LOG_JSON=true
APM_HEALTH_PORT=8080

# --- Watchlist (optional, comma-separated) (spec §4, §10) -------------------
APM_WATCHLIST=SPY,QQQ,NVDA,TSLA
